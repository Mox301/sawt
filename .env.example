# Copy to .env (git-ignored). Read by the API and `make models` when run natively, and
# passed to the api container by Docker Compose. Only HF_TOKEN needs a value; every other
# line shows the default: uncomment it to change it.

# Hugging Face token for the gated diarization model (native setups can use
# `hf auth login` instead). Accept its terms first:
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Inference device: auto (CUDA, then MPS, then CPU) | cuda | mps | cpu
# SAWT_DEVICE=auto
# Model precision: auto | bf16 | fp16 | fp32
# SAWT_DTYPE=auto

# EN→AR translation: transformers (Qwen3-4B on the same device) | ollama | off.
# `make dev-mac` always uses ollama; `make up-cpu` uses ollama unless this is set.
# SAWT_TRANSLATION_BACKEND=transformers
# Hugging Face model for the transformers backend
# SAWT_TRANSLATION_MODEL=Qwen/Qwen3-4B-Instruct-2507
# Ollama server for the ollama backend (Docker CPU uses host.docker.internal instead)
# SAWT_OLLAMA_URL=http://localhost:11434
# Ollama model for the ollama backend
# SAWT_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Audio-language model
# SAWT_AUDIO_MODEL=mistralai/Voxtral-Mini-3B-2507
# Speaker diarization model
# SAWT_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Set to false to skip diarization
# SAWT_ENABLE_DIARIZATION=true

# Upload and stream size limit, in MB (413 when exceeded)
# SAWT_MAX_UPLOAD_MB=100
# Longest recording analysed, in minutes (413 when exceeded)
# SAWT_MAX_AUDIO_MINUTES=40
# Concurrent WebSocket streams (429 when all are in use)
# SAWT_STREAM_MAX_SESSIONS=10
# Seconds without a message before a stream is closed
# SAWT_STREAM_IDLE_TIMEOUT_S=300
# Log level: DEBUG | INFO | WARNING | ERROR
# SAWT_LOG_LEVEL=INFO

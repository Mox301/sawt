# Copy to .env (git-ignored). Every setting is optional.

# Needed once to download the gated diarization model (or run `hf auth login`).
# Accept the terms at https://huggingface.co/pyannote/speaker-diarization-community-1 first.
HF_TOKEN=

# auto | cuda | mps | cpu      and      auto | bf16 | fp16 | fp32
SAWT_DEVICE=auto
SAWT_DTYPE=auto

# EN→AR translation: transformers (Qwen3-4B on the same device) | ollama | off
SAWT_TRANSLATION_BACKEND=transformers
SAWT_TRANSLATION_MODEL=Qwen/Qwen3-4B-Instruct-2507
SAWT_OLLAMA_URL=http://localhost:11434
SAWT_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

SAWT_AUDIO_MODEL=mistralai/Voxtral-Mini-3B-2507
SAWT_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
SAWT_ENABLE_DIARIZATION=true

SAWT_MAX_UPLOAD_MB=100
SAWT_STREAM_MAX_SESSIONS=10
SAWT_STREAM_IDLE_TIMEOUT_S=300
SAWT_LOG_LEVEL=INFO

# Frontend
SAWT_API_URL=http://localhost:8000
